{
  "version": 2,
  "builds": [
    {
      "src": "api/boot.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "api/**",
          "db/**",
          "contracts/**"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/boot.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
